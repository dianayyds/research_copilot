MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agent_studio
MYSQL_USER=agent
MYSQL_PASSWORD=agent
ENVIRONMENT=local
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_DIR=/models
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_LENGTH=2048
PDF_PARSER_PROVIDER=auto
GROBID_API_BASE=
GROBID_TIMEOUT_SECONDS=20.0
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MODEL_DIR=/models
RERANKER_DEVICE=cpu
RERANKER_MAX_LENGTH=1024
VECTOR_STORE_PROVIDER=qdrant
QDRANT_COLLECTION=knowledge_chunks
SEMANTIC_MEMORY_COLLECTION=semantic_memory_facts
HF_HUB_DISABLE_XET=1
EXECUTION_MODE=plan_react_mcp
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_HYDE_ENABLED=true
QUERY_REWRITE_STEP_BACK_ENABLED=true
QUERY_REWRITE_MAX_QUERIES=10
RETRIEVAL_CANDIDATE_LIMIT=16
ASSET_PARENT_CHUNK_TOKENS=1800
ASSET_CHILD_CHUNK_TOKENS=480
ASSET_CHILD_CHUNK_OVERLAP_TOKENS=80
ASSET_CONTEXT_SNIPPET_CHARS=1600
WORKING_MEMORY_TOKEN_THRESHOLD=1200
WORKING_MEMORY_COMPACTION_RATIO=0.75
EPISODIC_MEMORY_LIMIT=4
SEMANTIC_MEMORY_LIMIT=6
UPLOAD_MAX_BYTES=104857600
RESUMABLE_UPLOAD_MAX_BYTES=1073741824
RESUMABLE_UPLOAD_CHUNK_SIZE=8388608
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=agent-raw
MINIO_BUCKET_ARTIFACTS=agent-artifacts
LIVE_TOOLS_ENABLED=true
LLM_TOOL_PLANNER_ENABLED=true
LLM_TOOL_PLANNER_TIMEOUT_SECONDS=20.0
AGENT_MAX_STEPS=5
PUBLIC_WEB_SEARCH_ENABLED=true
LIVE_TOOL_TIMEOUT_SECONDS=8.0
PLAN_REACT_MAX_TASKS=6
PLAN_REACT_DEFAULT_NODE_ITERATIONS=4
PLAN_REACT_LLM_TIMEOUT_SECONDS=60.0
MCP_ENABLED=true
MCP_GITHUB_ENABLED=true
MCP_GITHUB_TRANSPORT=stdio
MCP_GITHUB_COMMAND=docker run --rm -i -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server
MCP_GITHUB_ALLOWED_SIDE_EFFECT_TOOLS=
MCP_GITHUB_URL=
MCP_PROTOCOL_VERSION=2025-06-18
MCP_REQUEST_TIMEOUT_SECONDS=30.0
MCP_INITIALIZE_TIMEOUT_SECONDS=20.0
GITHUB_PERSONAL_ACCESS_TOKEN=

BACKEND_PORT=8001
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
